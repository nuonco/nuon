# Nuon local development environment variables
#
# Copy this file to `.env.dev` and fill in the secret placeholders below.
# `.env.dev` is gitignored and loaded automatically by direnv (see .envrc.example:
# `dotenv_if_exists .env.dev`). Never commit real secrets.

# Service identity
export GIT_REF=local-dev
export SERVICE_NAME=ctl-api
export SERVICE_TYPE=api
export HOST_IP=127.0.0.1
export GRACEFUL_SHUTDOWN_TIMEOUT=5s

# PostgreSQL
export DB_HOST=127.0.0.1
export DB_SSL_MODE=disable

# ClickHouse
export CLICKHOUSE_DB_HOST=127.0.0.1
export CLICKHOUSE_DB_PORT=9000
export CLICKHOUSE_DB_USER=default
export CLICKHOUSE_DB_PASSWORD=local
export CLICKHOUSE_DB_NAME=ctl_api

# Sandbox mode
export FORCE_SANDBOX_MODE=true

# URLs
export APP_URL=http://localhost:4000
export ADMIN_API_URL=http://localhost:8082
export TEMPORAL_UI_URL=http://localhost:8233

# Runner stubs
export RUNNER_CONTAINER_IMAGE_TAG=latest

# Cloud infra stubs (bypassed by sandbox mode)
export MANAGEMENT_ACCOUNT_ID=000000000000
export ORG_RUNNER_K8S_CLUSTER_ID=local-dev
export ORG_RUNNER_K8S_PUBLIC_ENDPOINT=https://localhost
export ORG_RUNNER_K8S_CA_DATA=local-dev
export ORG_RUNNER_REGION=us-west-2
export DNS_ZONE_ID=local-dev
export DNS_ROOT_DOMAIN=localhost
export INTEGRATION_GITHUB_INSTALL_ID=0

# GitHub app stubs
export GITHUB_APP_ID=1

# Notifications & analytics (disabled)
export LOOPS_API_KEY=replace-me
export INTERNAL_SLACK_WEBHOOK_URL=http://localhost/noop
export SEGMENT_WRITE_KEY=local-dev
export DISABLE_NOTIFICATIONS=true
export DISABLE_ANALYTICS=true
ENV=development
export GITHUB_APP_KEY_SECRET_NAME=replace-me

# Missing required config
export ROOT_DOMAIN=localhost
export TEMPORAL_HOST=127.0.0.1:7233
export VERSION=dev
export TEMPORAL_TASK_QUEUE=local
export TEMPORAL_MAX_CONCURRENT_ACTIVITIES=10
export DB_NAME=ctl_api
export DB_PORT=5432
export DB_USER=ctl_api

# Auth (Google OAuth) — supply your own dev OAuth app credentials
export NUON_AUTH_PROVIDER_TYPE=google
export NUON_AUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
export NUON_AUTH_CLIENT_SECRET=replace-me
export NUON_AUTH_REDIRECT_URL=http://localhost:8084/auth
export NUON_AUTH_ALLOW_ALL_USERS=true
export NUON_AUTH_ISSUER_URL=https://accounts.google.com

# Middleware configuration (order matters: left = outermost)
export MIDDLEWARES=chaos,tracer,public_metrics,error,public,size,global,public_audit,auth,org,log,offset_pagination,invites,headers,cors,config,patcher,panicker
export RUNNER_MIDDLEWARES=chaos,tracer,runner_metrics,error,size,public,runner_audit,auth,runner_org,log,offset_pagination,headers,cors,config,patcher,panicker
export INTERNAL_MIDDLEWARES=chaos,tracer,internal_metrics,error,size,internal_audit,public,log,global,config,admin,offset_pagination,cors,config,patcher,panicker
