# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

.env
coverage/
node_modules/
dist/
bin/
.mintlify-last/

# filter out deployment and infra
**/k8s/charts/
**/.terraform
**/terraform.tfvars
**/terraform.tfvars.json
**/config.*.tfbackend
**/tfplan
**/terraform.tfstate
**/terraform.tfstate.*

# Test output directories
pkg/config/generator/test-app-config/
pkg/config/generator/test-config-init/

go.work

Brewfile.lock.json

# go debug binaries
__debug_bin
# Ignore secret files
.secret

services/ctl-api/ctl-api/.restart
sdks/nuon-go/.swagger.stamp
sdks/nuon-runner-go/.swagger.stamp

# MacOS files
.DS_Store
.vscode/
.zed/

# ignore binaries
services/ctl-api/ctl-api
services/ctl-api/cmd/nuontest/nuontest
services/workers-executors/workers-executors
services/workers-canary/workers-canary
bins/runner/runner
bins/nuonctl/nuonctl
.parrot.md

**/.claude/settings.local.json

# IntelliJ IDEA
.idea/

# LSP binary and VS Code extension
bins/lsp/lsp
*.vsix

# ignore workspaces
ws-*/
agent-day2/
agent-day2/*
