# Environment for running ctl-api integration suites locally.
# See conventions/testing.md ("Running integration suites locally").
#
# Usage, from services/ctl-api, with the dev dependency stack running:
#
#   source tests/integration.env
#   go run ./cmd/nuontest        # once: creates + migrates ctl_api_test databases
#   go test -count=1 ./...       # or a specific package
#
# The flow testworker suite is driven by tests/run-flow-test.sh, which sources
# this file and swaps GITHUB_APP_KEY for a generated PEM (see below).
#
# Inert dummies for config the fx graph requires but these suites never use. No real
# credentials belong here.
#
# DB_NAME must stay ctl_api_test: nuontest DROPS and recreates the named database.

export INTEGRATION=true

export ENV=development
export SERVICE_NAME=ctl-api-test
export SERVICE_TYPE=test
export GIT_REF=local
export HOST_IP=localhost
export GRACEFUL_SHUTDOWN_TIMEOUT=1s

# postgres (dev docker-compose stack)
export DB_HOST=localhost
export DB_USER=ctl_api
export DB_PASSWORD=password
export DB_NAME=ctl_api_test
export DB_SSL_MODE=disable

# clickhouse (dev docker-compose stack)
export CLICKHOUSE_DB_HOST=127.0.0.1
export CLICKHOUSE_DB_PORT=9000
export CLICKHOUSE_DB_USER=ctl-api
export CLICKHOUSE_DB_PASSWORD=ctl-api
export CLICKHOUSE_DB_NAME=ctl_api_test

# temporal (dev docker-compose stack)
export TEMPORAL_HOST=localhost:7233

# required-by-validation fields the suites never exercise; dummies on purpose.
# GITHUB_APP_KEY only has to be non-empty here, but any suite that builds the
# github client needs a parseable PEM — run-flow-test.sh generates one.
export GITHUB_APP_ID=1
export GITHUB_APP_KEY=dummy
export INTEGRATION_GITHUB_INSTALL_ID=1
export LOOPS_API_KEY=dummy
export SEGMENT_WRITE_KEY=dummy
export APP_URL=http://localhost:4000
export ADMIN_API_URL=http://localhost:8082
export TEMPORAL_UI_URL=http://localhost:8233
export RUNNER_CONTAINER_IMAGE_TAG=latest
export MANAGEMENT_ACCOUNT_ID=000000000000
export MANAGEMENT_IAM_ROLE_ARN=arn:aws:iam::000000000000:role/test
export MANAGEMENT_ECR_REGISTRY_ID=000000000000
export ORG_RUNNER_K8S_CLUSTER_ID=test
export ORG_RUNNER_K8S_PUBLIC_ENDPOINT=https://localhost
export ORG_RUNNER_K8S_CA_DATA=dGVzdA==
export ORG_RUNNER_REGION=us-east-1
export DNS_ZONE_ID=test
export DNS_ROOT_DOMAIN=nuon.test
